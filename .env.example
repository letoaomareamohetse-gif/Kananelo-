# Pips Hunter Bot - Environment Variables
# Copy this file to .env and fill in your actual credentials

# ─────────────────────────────────────────────
# BROKER API CREDENTIALS (OANDA)
# ─────────────────────────────────────────────
OANDA_ACCOUNT_ID=your_account_id_here
OANDA_API_KEY=your_api_key_here

# ─────────────────────────────────────────────
# BROKER API CREDENTIALS (IQ Option)
# ─────────────────────────────────────────────
IQOPTION_EMAIL=your_email@example.com
IQOPTION_PASSWORD=your_password_here

# ─────────────────────────────────────────────
# EMAIL NOTIFICATIONS (Gmail, Outlook, etc.)
# ─────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password_here
NOTIFY_EMAIL=recipient@example.com

# ─────────────────────────────────────────────
# TELEGRAM NOTIFICATIONS
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ─────────────────────────────────────────────
# SMS NOTIFICATIONS (Twilio)
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE=+1234567890
NOTIFY_PHONE=+recipient_phone_number

# ─────────────────────────────────────────────
# DATA SOURCES
# ─────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_URL=sqlite:///pips_hunter.db

# ─────────────────────────────────────────────
# TRADING MODE
# ─────────────────────────────────────────────
TRADING_MODE=demo  # Set to 'live' for real trading (USE WITH CAUTION!)
